# Supabase — public (anon/publishable) credentials only.
# NEVER put the service_role key here or anywhere in frontend code.
# Copy this file to .env.local and fill in your project's values from:
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Stripe — PUBLIC identifiers only (Price IDs), never the secret key.
# Create these in the Stripe Dashboard → Product catalog → Soul Garden
# Premium → Monthly / Yearly prices. See supabase/functions/README.md.
VITE_STRIPE_PRICE_MONTHLY=
VITE_STRIPE_PRICE_YEARLY=
# Optional: Stripe customer billing portal link, shown to already-subscribed
# users under Settings/Subscription -> "Manage subscription".
VITE_STRIPE_BILLING_PORTAL_URL=

# ---------------------------------------------------------------------------
# The following are SERVER-SIDE ONLY and do NOT belong in this file or any
# VITE_-prefixed variable. Set them with `supabase secrets set` instead —
# see supabase/functions/README.md.
#   STRIPE_SECRET_KEY
#   STRIPE_WEBHOOK_SECRET
#   SUPABASE_SERVICE_ROLE_KEY (provided automatically to Edge Functions)

